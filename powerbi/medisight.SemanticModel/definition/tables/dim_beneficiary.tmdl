	column 'Age Group Sort Order' =
			
			SWITCH(
			    TRUE(),
			    dim_beneficiary[patient_age] < 65, 1,
			    dim_beneficiary[patient_age] <= 74, 2,
			    dim_beneficiary[patient_age] <= 84, 3,
			    dim_beneficiary[patient_age] >= 85, 4,
			    99
			)
		formatString: 0
		lineageTag: 99ac3ca1-dcb0-464f-b09a-593c4db689bb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dim_beneficiary = m
		mode: import
		source =
				let
				    Source = Sql.Databases("LAPTOP-03S07GO9"),
				    MediSight = Source{[Name="MediSight"]}[Data],
				    gold_dim_beneficiary = MediSight{[Schema="gold",Item="dim_beneficiary"]}[Data]
				in
				    gold_dim_beneficiary

	changedProperty = Name

	annotation PBI_ResultType = Table

