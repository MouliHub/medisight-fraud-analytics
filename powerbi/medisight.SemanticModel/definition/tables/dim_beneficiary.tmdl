table dim_beneficiary
	lineageTag: 3859d777-dbaf-4338-a483-76a0d00c48ed

	measure 'Beneficiary Annual Cost' =
			
			SUM(dim_beneficiary[ip_annual_reimbursement_amt]) + SUM(dim_beneficiary[op_annual_reimbursement_amt])
		formatString: 0
		lineageTag: e0dfff2a-6152-4186-b566-26bceb30ac89

	measure 'Care Management Priority Flag' =
			
			VAR CondCount = MAX(dim_beneficiary[chronic_condition_count])
			VAR HasClaimsInContext = CALCULATE(COUNTROWS(fact_claims)) > 0
			RETURN
			    IF(
			        NOT HasClaimsInContext,
			        "⚪ No Claims in Current Filter",
			        IF(
			            CondCount >= 6 && [Beneficiary Annual Cost] >= 10000,
			            "🔴 High Priority — Enroll",
			            IF(CondCount >= 6 || [Beneficiary Annual Cost] >= 10000,
			                "🟠 Moderate Priority — Consider",
			                "🟢 Standard Care")
			        )
			    )
		lineageTag: 2fe7316d-8130-457b-9fdf-45eba0064b13

	measure 'Beneficiaries Recommended for Enrollment' =
			
			VAR Capacity = SELECTEDVALUE('Care Manager Capacity'[Care Manager Capacity], 5000)
			VAR RankedPool =
			    FILTER(
			        VALUES(dim_beneficiary[beneficiary_id]),
			        CALCULATE(MAX(dim_beneficiary[chronic_condition_count])) >= 6 &&
			        [Beneficiary Annual Cost] >= 10000 &&
			        CALCULATE(COUNTROWS(fact_claims)) > 0
			    )
			RETURN
			    MIN(Capacity, COUNTROWS(RankedPool))
		formatString: 0
		lineageTag: e1b75b94-4c87-4c8c-b08d-ddbe630551a4

	measure 'Total High Priority Beneficiaries' =
			
			CALCULATE(
			    DISTINCTCOUNT(dim_beneficiary[beneficiary_id]),
			    FILTER(
			        VALUES(dim_beneficiary[beneficiary_id]),
			        CALCULATE(MAX(dim_beneficiary[chronic_condition_count])) >= 6 &&
			        [Beneficiary Annual Cost] >= 10000 &&
			        CALCULATE(COUNTROWS(fact_claims)) > 0
			    )
			)
		formatString: 0
		lineageTag: d52a03bb-c6cf-4764-9659-99a5ce61715d

	measure 'Projected Care Mgmt Savings' =
			
			VAR EnrolledCost =
			    SUMX(
			        FILTER(VALUES(dim_beneficiary[beneficiary_id]), [Care Management Priority Flag] = "🔴 High Priority — Enroll"),
			        [Beneficiary Annual Cost]
			    )
			VAR AvoidableUtilizationRate = 0.12
			RETURN
			    EnrolledCost * AvoidableUtilizationRate
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: c6f4deef-30e1-4d66-a92d-f3199555274b

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

