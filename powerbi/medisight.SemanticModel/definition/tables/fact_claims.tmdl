	partition fact_claims = m
		mode: import
		source =
				let
				    Source = Sql.Databases("LAPTOP-03S07GO9"),
				    MediSight = Source{[Name="MediSight"]}[Data],
				    gold_fact_claims = MediSight{[Schema="gold",Item="fact_claims"]}[Data]
				in
				    gold_fact_claims

	changedProperty = Name

	annotation PBI_ResultType = Table

