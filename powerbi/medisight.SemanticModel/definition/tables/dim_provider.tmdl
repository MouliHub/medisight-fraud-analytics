	column dwh_created_at
		dataType: dateTime
		formatString: General Date
		lineageTag: 32e40328-bde7-423f-9a0d-393ab5aeebaa
		summarizeBy: none
		sourceColumn: dwh_created_at

		annotation SummarizationSetBy = Automatic

	column 'Risk Category' =
			
			VAR Score =
			    CALCULATE([Provider Risk Score])
			RETURN
			    IF(Score >= 9,  "🔴 Critical",
			    IF(Score >= 6,  "🟠 High",
			    IF(Score >= 3,  "🟡 Medium",
			    IF(Score >= 1,  "🟢 Low",
			                    "⚪ Clean"))))
		lineageTag: b3b185a1-e16f-4d50-b52c-1a3d0496df53
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Payment Hold Recommendation (Column)' =
			
			VAR MinVolume = CALCULATE([Total Claims]) >= 5
			VAR SameDayFlag = CALCULATE([Same Day Discharge %]) > 0.10
			VAR PaddingFlag = CALCULATE([Diagnosis Padding Score]) > 8.5
			RETURN
			SWITCH(
			    TRUE(),
			    NOT MinVolume, "⚪ Insufficient Volume for Assessment",
			    SameDayFlag && PaddingFlag, "🔴 Recommend Payment Hold — Pending Review",
			    SameDayFlag || PaddingFlag, "🟠 Recommend Pre-Payment Review",
			    "🟢 Standard Processing"
			)
		lineageTag: 01076f90-87e1-401d-834c-eb5f8342f127
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dim_provider = m
		mode: import
		source =
				let
				    Source = Sql.Databases("LAPTOP-03S07GO9"),
				    MediSight = Source{[Name="MediSight"]}[Data],
				    gold_dim_provider = MediSight{[Schema="gold",Item="dim_provider"]}[Data]
				in
				    gold_dim_provider

	changedProperty = Name

	annotation PBI_ResultType = Table

